---
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Garden Skittles | GrandPlay</title>
    <meta name="description" content="Play GrandPlay garden skittles. Bowl a strike to reveal a discount code." />
    <meta name="theme-color" content="#2e5e40" />
    <link rel="icon" href={`${base}favicon.png`} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="top">
      <a href={base} aria-label="GrandPlay home"><img src={`${base}logo.png`} alt="GrandPlay" width="96" height="65" /></a>
      <a class="pill" href={base}><span aria-hidden="true">←</span> Back to the shop</a>
    </header>

    <main>
      <div class="intro">
        <h1>Garden skittles</h1>
        <p>Click once to set your aim, then again to set your power. Knock down all nine pins, including the turquoise GrandPlay king pin, to bowl a strike and reveal a discount code.</p>
        <p class="best">Best score: <strong id="best">0 / 9</strong></p>
      </div>

      <div class="stage">
        <canvas id="lawn" width="960" height="600" tabindex="0" aria-label="Garden skittles lawn. Press Space or click to set aim, then again to set power." role="img"></canvas>
        <p class="prompt" id="prompt" aria-live="polite"></p>

        <div class="card" id="result" hidden>
          <p id="result-text"></p>
          <button type="button" class="pill solid" id="again">Bowl again</button>
        </div>

        <div class="card strike" id="strike" hidden role="dialog" aria-labelledby="strike-title">
          <p class="eyebrow">Strike!</p>
          <h2 id="strike-title">You've won a discount</h2>
          <p class="code" id="code"></p>
          <p class="demo">Demo code only. This is a preview, so the code can't be used for real purchases.</p>
          <button type="button" class="pill solid" id="strike-again">Play again</button>
        </div>
      </div>
      <p class="hint">Tip: aim just off centre to hit the "pocket" between the front pins. Keyboard: Space or Enter.</p>
    </main>

    <script>
      import '../../scripts/skittles-game.js';
    </script>

    <style is:global>
      :root { --cream: #fbf8ef; --ink: #2d2b29; --ink-soft: rgb(45 43 41 / .65); --green: #2e5e40; --green-dark: #1f4430; --wood: #9a5b2e; --teal: #2bb3b1; --gutter: clamp(16px, 3vw, 40px); }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--cream); color: var(--ink); font-family: 'Inter Tight', system-ui, -apple-system, sans-serif; line-height: 1.45; }
      .top { display: flex; justify-content: space-between; align-items: center; padding: 14px var(--gutter); }
      .top img { height: 52px; width: auto; display: block; }
      .pill { display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; text-decoration: none; font: 500 .95rem 'Inter Tight', system-ui, sans-serif; padding: 9px 16px; border: 1px solid rgb(45 43 41 / .25); color: var(--ink); background: transparent; cursor: pointer; }
      .pill.solid { background: var(--green); color: var(--cream); border: 0; padding: 12px 22px; font-size: 1.05rem; }
      .pill.solid:hover { background: var(--green-dark); }
      main { max-width: 1100px; margin: 0 auto; padding: 8px var(--gutter) 48px; }
      .intro { display: grid; gap: 10px; margin-bottom: 20px; }
      h1 { font-size: clamp(2.4rem, 6vw, 4rem); font-weight: 500; letter-spacing: -0.035em; line-height: 1; margin: 0; }
      .intro p { margin: 0; max-width: 60ch; }
      .best { color: var(--ink-soft); }
      .best strong { color: var(--green); }
      .stage { position: relative; border-radius: 20px; overflow: hidden; box-shadow: 0 10px 40px rgb(0 0 0 / .12); }
      canvas { display: block; width: 100%; height: auto; aspect-ratio: 960 / 600; cursor: pointer; touch-action: manipulation; }
      canvas:focus-visible { outline: 3px solid var(--green); outline-offset: -3px; }
      .prompt { position: absolute; top: 16px; left: 50%; transform: translateX(-50%); margin: 0; background: rgb(251 248 239 / .92); padding: 8px 18px; border-radius: 999px; font-weight: 600; pointer-events: none; white-space: nowrap; }
      .prompt:empty { display: none; }
      .card { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); background: var(--cream); border-radius: 18px; padding: 24px 28px; text-align: center; display: grid; gap: 14px; justify-items: center; box-shadow: 0 12px 40px rgb(0 0 0 / .25); width: min(420px, calc(100% - 32px)); }
      .card[hidden] { display: none; }
      .card p { margin: 0; }
      .strike h2 { margin: 0; font-size: clamp(1.5rem, 4vw, 2.2rem); font-weight: 500; letter-spacing: -0.03em; }
      .eyebrow { color: var(--wood); font-weight: 600; text-transform: uppercase; letter-spacing: .12em; font-size: .85rem; }
      .code { font: 600 clamp(1.1rem, 3.5vw, 1.6rem) ui-monospace, 'SF Mono', Menlo, monospace; letter-spacing: .06em; background: #fff; border: 2px dashed var(--teal); border-radius: 12px; padding: 10px 16px; user-select: all; }
      .demo { font-size: .85rem; color: var(--ink-soft); max-width: 32ch; }
      .hint { color: var(--ink-soft); font-size: .9rem; margin-top: 14px; }
      @media (max-width: 600px) { canvas { aspect-ratio: 960 / 860; } .prompt { font-size: .85rem; } }
    </style>
  </body>
</html>
