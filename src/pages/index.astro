---
import { Image } from 'astro:assets';
import chess from '../assets/chess.jpg';
import tower from '../assets/tower.jpg';
import four from '../assets/four.jpg';
import bowling from '../assets/bowling.jpg';
import moon from '../assets/moon.jpg';

const base = import.meta.env.BASE_URL;

// ---- Content (edit here) -------------------------------------------------
const products = [
  { name: 'Giant Chess', img: chess, blurb: 'The classic battle of wits, now knee-high on the lawn.', price: 'Price TBC' },
  { name: 'Giant Jenga', img: tower, blurb: 'Stack it tall, pull it carefully, and wait for the crash.', price: 'Price TBC' },
  { name: 'Giant Connect Four', img: four, blurb: 'Drop, block and line up four before your rival does.', price: 'Price TBC' },
  { name: 'Giant Bowling', img: bowling, blurb: 'Solid wooden pins for a strike on any patch of grass.', price: 'Price TBC' },
];

const occasions = ['Family gatherings', 'BBQs', 'Garden parties', 'Birthdays', 'Weddings', 'Festivals'];

const benefits = [
  { title: 'Breaks the ice', text: 'A giant game gets everyone involved.' },
  { title: 'Creates memories', text: 'Experiences, not just games.' },
  { title: 'Fun from 5 to 55', text: 'Every age loves friendly competition.' },
];

const shopUrl = '#contact';            // TODO: shop or pre-order link
const contactEmail = 'hello@example.com'; // TODO: real contact email
// --------------------------------------------------------------------------
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GrandPlay | Giant garden games by HY-PRO</title>
    <meta name="description" content="GrandPlay is HY-PRO's new range of giant garden and lawn games. Think big. Play big." />
    <meta property="og:title" content="GrandPlay | Think big. Play big." />
    <meta property="og:description" content="Giant garden and lawn games that bring people together outdoors." />
    <link rel="icon" href={`${base}moon-icon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="nav">
      <a class="brand" href={base}>
        <img src={`${base}moon-icon.svg`} alt="" width="28" height="28" />
        <span>GrandPlay</span>
      </a>
      <nav>
        <a href="#games">Games</a>
        <a href="#why">Why GrandPlay</a>
        <a href="#about">About</a>
        <a class="btn btn-small" href={shopUrl}>Get yours</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="stars" aria-hidden="true"></div>
        <div class="hero-inner">
          <p class="eyebrow">Introducing GrandPlay</p>
          <h1>Think big.<br />Play big.</h1>
          <p class="lead">Giant garden and lawn games that get people off their screens and playing together outdoors.</p>
          <div class="cta">
            <a class="btn" href="#games">See the games</a>
            <a class="btn btn-ghost" href="#video">▶ Watch the video</a>
          </div>
        </div>
        <Image src={moon} alt="" class="moon" widths={[800, 1200]} sizes="100vw" loading="eager" />
      </section>

      <section class="section problem">
        <h2>Our free time goes on screens, often alone</h2>
        <div class="compare">
          <div class="card">
            <h3>Today</h3>
            <ul><li>Scrolling social media</li><li>Playing games on our phones</li><li>Browsing the internet</li></ul>
          </div>
          <div class="arrow" aria-hidden="true">→</div>
          <div class="card card-accent">
            <h3>What we want</h3>
            <ul><li>Put our phones down</li><li>Get outside and get moving</li><li>Have fun with real people</li></ul>
          </div>
        </div>
      </section>

      <section class="section" id="games">
        <p class="eyebrow">The first collection</p>
        <h2>Four classic games, given the giant treatment</h2>
        <div class="grid">
          {products.map((p) => (
            <article class="product">
              <Image src={p.img} alt={p.name} widths={[320, 640]} sizes="(max-width: 700px) 90vw, 280px" />
              <div class="product-body">
                <h3>{p.name}</h3>
                <p>{p.blurb}</p>
                <span class="price">{p.price}</span>
              </div>
            </article>
          ))}
        </div>
        <p class="occasions-label">Made for the moments people come together</p>
        <ul class="chips">{occasions.map((o) => <li>{o}</li>)}</ul>
      </section>

      <section class="section" id="why">
        <h2 class="center">Welcome to GrandPlay</h2>
        <div class="rule" aria-hidden="true"></div>
        <div class="benefits">
          {benefits.map((b) => (
            <div><h3>{b.title}</h3><p>{b.text}</p></div>
          ))}
        </div>
      </section>

      <section class="section" id="video">
        <h2>See GrandPlay in action</h2>
        <div class="video">
          <video controls playsinline preload="metadata" poster={`${base}video/poster.jpg`}>
            <source src={`${base}video/grandplay.mp4`} type="video/mp4" />
            Your browser can't play this video.
          </video>
        </div>
      </section>

      <section class="section about" id="about">
        <div class="stat"><span class="big">30+</span><span>years in the sports and outdoor industry</span></div>
        <div>
          <h2>Brought to you by HY-PRO</h2>
          <p>HY-PRO has spent over 30 years getting people active outdoors, which makes it the right business to bring a new concept like this to life.</p>
        </div>
      </section>

      <section class="section contact" id="contact">
        <h2>Be first to play big</h2>
        <p>Pricing and availability coming soon. Get in touch to register your interest.</p>
        <a class="btn" href={`mailto:${contactEmail}`}>Register interest</a>
      </section>
    </main>

    <footer>
      <p>© {new Date().getFullYear()} HY-PRO. GrandPlay is a HY-PRO brand.</p>
      <p class="muted">Created by The Moonwalkers. Bringing people together outdoors.</p>
    </footer>

    <style is:global>
      :root {
        --bg: #0a0d26; --bg-2: #131845; --card: #1b2160; --accent: #4f46c8;
        --violet: #b8b2ff; --gold: #f5d06b; --text: #f4f5ff; --muted: #a9acd0;
        --radius: 24px;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; background: var(--bg); color: var(--text); font-family: Inter, system-ui, -apple-system, sans-serif; line-height: 1.55; }
      img { max-width: 100%; height: auto; display: block; }
      a { color: inherit; }
      h1, h2, h3 { line-height: 1.15; margin: 0 0 .5em; letter-spacing: -0.01em; }
      h2 { font-size: clamp(1.6rem, 3.5vw, 2.4rem); }

      .nav { position: sticky; top: 0; z-index: 10; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .9rem clamp(16px, 4vw, 48px); background: rgb(10 13 38 / .85); backdrop-filter: blur(10px); }
      .brand { display: flex; align-items: center; gap: .5rem; font-weight: 800; font-size: 1.25rem; text-decoration: none; }
      .nav nav { display: flex; align-items: center; gap: 1.4rem; }
      .nav nav a:not(.btn) { text-decoration: none; color: var(--muted); font-weight: 500; }
      .nav nav a:not(.btn):hover { color: var(--text); }

      .btn { display: inline-block; background: var(--gold); color: #1a1a2e; font-weight: 700; padding: .85rem 1.5rem; border-radius: 999px; text-decoration: none; transition: transform .15s; }
      .btn:hover { transform: translateY(-2px); }
      .btn-small { padding: .5rem 1rem; font-size: .9rem; }
      .btn-ghost { background: transparent; color: var(--gold); border: 2px solid var(--gold); }

      .hero { position: relative; min-height: 88vh; display: grid; place-items: center; text-align: center; overflow: hidden; padding: 6rem 16px 0; }
      .stars { position: absolute; inset: 0; background-image:
        radial-gradient(1px 1px at 10% 20%, #fff8, transparent), radial-gradient(1px 1px at 30% 70%, #fff6, transparent),
        radial-gradient(1.5px 1.5px at 55% 15%, #fff9, transparent), radial-gradient(1px 1px at 75% 45%, #fff7, transparent),
        radial-gradient(1px 1px at 90% 25%, #fff6, transparent), radial-gradient(1.5px 1.5px at 20% 40%, #fff5, transparent),
        radial-gradient(1px 1px at 65% 60%, #fff6, transparent), radial-gradient(1px 1px at 45% 35%, #fff4, transparent);
        background-size: 400px 400px; }
      .hero-inner { position: relative; z-index: 1; max-width: 760px; margin-bottom: 22vh; }
      .hero h1 { font-size: clamp(2.8rem, 8vw, 5.5rem); font-weight: 800; }
      .eyebrow { color: var(--gold); font-weight: 600; text-transform: uppercase; letter-spacing: .12em; font-size: .85rem; margin: 0 0 .8rem; }
      .lead { font-size: clamp(1.05rem, 2vw, 1.3rem); color: var(--muted); margin: 0 auto 2rem; max-width: 560px; }
      .cta { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
      .moon { position: absolute; bottom: 0; left: 0; width: 100%; height: 18vh; object-fit: cover; object-position: center top; }

      .section { max-width: 1140px; margin: 0 auto; padding: clamp(4rem, 9vw, 7rem) clamp(16px, 4vw, 48px); }
      .center { text-align: center; }

      .compare { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1.5rem; align-items: center; margin-top: 2rem; }
      .card { background: var(--bg-2); border-radius: var(--radius); padding: 2rem; }
      .card-accent { background: var(--accent); }
      .card h3 { color: var(--muted); font-size: 1rem; }
      .card-accent h3 { color: #e7e5ff; }
      .card ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .9rem; font-weight: 500; }
      .arrow { font-size: 2.5rem; color: var(--gold); }

      .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; margin-top: 2.5rem; }
      .product { background: var(--bg-2); border-radius: var(--radius); overflow: hidden; transition: transform .2s; }
      .product:hover { transform: translateY(-4px); }
      .product img { aspect-ratio: 1; object-fit: cover; width: 100%; }
      .product-body { padding: 1.25rem 1.4rem 1.5rem; }
      .product-body p { color: var(--muted); font-size: .95rem; margin: 0 0 1rem; }
      .price { color: var(--gold); font-weight: 600; font-size: .9rem; }

      .occasions-label { color: var(--muted); margin: 3rem 0 1rem; font-weight: 500; }
      .chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .7rem; }
      .chips li { border: 1.5px solid var(--violet); color: var(--violet); border-radius: 999px; padding: .4rem 1rem; font-size: .9rem; font-weight: 500; }

      .rule { width: 60px; height: 3px; background: var(--gold); margin: 1rem auto 3rem; border-radius: 2px; }
      .benefits { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; text-align: center; }
      .benefits p { color: var(--muted); margin: 0; }

      .video { position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden; background: var(--bg-2); margin-top: 1.5rem; }
      .video video { width: 100%; height: 100%; display: block; object-fit: cover; }

      .about { display: grid; grid-template-columns: auto 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; }
      .stat { display: grid; max-width: 260px; font-weight: 600; }
      .stat .big { font-size: clamp(4rem, 10vw, 7rem); font-weight: 800; color: var(--violet); line-height: 1; }
      .about p { color: var(--muted); font-size: 1.1rem; }

      .contact { text-align: center; background: var(--bg-2); border-radius: var(--radius); margin-bottom: 4rem; }
      .contact p { color: var(--muted); margin-bottom: 2rem; }

      footer { text-align: center; padding: 2rem 16px 3rem; border-top: 1px solid #ffffff14; font-size: .9rem; }
      footer p { margin: .25rem 0; }
      .muted { color: var(--muted); }

      @media (max-width: 900px) {
        .grid { grid-template-columns: repeat(2, 1fr); }
      }
      @media (max-width: 700px) {
        .nav nav a:not(.btn) { display: none; }
        .compare { grid-template-columns: 1fr; }
        .arrow { transform: rotate(90deg); justify-self: center; }
        .grid, .benefits, .about { grid-template-columns: 1fr; }
      }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .btn, .product { transition: none; } }
    </style>
  </body>
</html>
