---
import { Image } from 'astro:assets';
import chess from '../assets/chess.jpg';
import tower from '../assets/tower.jpg';
import four from '../assets/four.jpg';
import bowling from '../assets/bowling.jpg';
import weddingChess from '../assets/wedding-chess.jpg';
import gardenBowling from '../assets/garden-bowling.jpg';
import moonTeam from '../assets/moon-team.jpg';

const base = import.meta.env.BASE_URL;

// ---- Content (edit here) -------------------------------------------------
// Prices in whole pounds for sizes S, M, L, XL. "From" price is the S size.
const products = [
  { id: 'chess', name: 'Giant Chess', img: chess, blurb: 'The classic battle of wits, now knee-high on the lawn.', prices: { S: 400, M: 550, L: 750, XL: 1000 } },
  { id: 'jenga', name: 'Giant Jenga', img: tower, blurb: 'Stack it tall, pull it carefully, and wait for the crash.', prices: { S: 100, M: 140, L: 190, XL: 250 } },
  { id: 'connect-four', name: 'Giant Connect Four', img: four, blurb: 'Drop, block and line up four before your rival does.', prices: { S: 150, M: 200, L: 270, XL: 350 } },
  { id: 'bowling', name: 'Giant Bowling', img: bowling, blurb: 'Solid wooden pins for a strike on any patch of grass.', prices: { S: 60, M: 85, L: 115, XL: 150 } },
];
const gbp = (n: number) => '£' + n.toLocaleString('en-GB');

const occasions = ['Family gatherings', 'BBQs', 'Garden parties', 'Birthdays', 'Weddings', 'Festivals'];

const benefits = [
  { title: 'Breaks the ice', text: 'A giant game gets everyone involved.' },
  { title: 'Creates memories', text: 'Experiences, not just games.' },
  { title: 'Fun for all ages', text: 'Every age loves friendly competition.' },
];

const contactEmail = 'rania@hy-pro.co.uk'; // TODO: real contact email
// --------------------------------------------------------------------------
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GrandPlay | Giant garden games by HY-PRO</title>
    <meta name="description" content="GrandPlay is HY-PRO's new range of giant garden and lawn games. Think big. Play big." />
    <meta property="og:title" content="GrandPlay | Think big. Play big." />
    <meta property="og:description" content="Giant garden and lawn games that bring people together outdoors." />
    <meta name="theme-color" content="#2e5e40" />
    <link rel="icon" href={`${base}favicon.png`} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>

    <header class="nav">
      <a class="brand" href={base} aria-label="GrandPlay home">
        <img src={`${base}logo-cream.png`} alt="" class="logo-light" width="96" height="65" />
        <img src={`${base}logo.png`} alt="" class="logo-dark" width="96" height="65" />
      </a>
      <nav aria-label="Main">
        <a class="pill pill-glass" href="#games">Games</a>
        <a class="pill pill-glass" href={`${base}play/`}>Play</a>
        <button type="button" class="pill pill-glass basket-btn" data-basket-open aria-label="Open basket">Basket <span class="basket-count" data-basket-count>0</span></button>
      </nav>
    </header>

    <main id="main">
      <!-- Hero: full-bleed video, headline bottom-left -->
      <section class="hero">
        <video autoplay muted loop playsinline preload="metadata" poster={`${base}video/poster.jpg`} aria-hidden="true">
          <source src={`${base}video/grandplay.mp4`} type="video/mp4" />
        </video>
        <div class="hero-shade" aria-hidden="true"></div>
        <h1>Think big.<br />Play big.</h1>
        <a class="scroll-cue" href="#main-content">
          <span>Scroll to explore</span>
          <svg width="44" height="68" viewBox="0 0 18 28" aria-hidden="true"><rect x="1" y="1" width="16" height="26" rx="8" fill="none" stroke="currentColor" stroke-width="1.5"/><circle class="scroll-dot" cx="9" cy="8" r="2" fill="currentColor"/></svg>
          <svg class="chev" width="36" height="20" viewBox="0 0 28 16" aria-hidden="true"><path d="M2 2l12 12L26 2" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </section>

      <!-- Intro: heading + copy left, image right -->
      <section class="wrap intro" id="main-content">
        <div class="intro-text">
          <h2>Bringing people together outdoors</h2>
          <p>GrandPlay is a new range of giant garden and lawn games that gets people to put their phones down, get outside and have fun with real people.</p>
          <a class="arrow-link" href="#games">See the games <span aria-hidden="true">→</span></a>
        </div>
        <Image src={weddingChess} alt="Wedding guests gathered round a giant chess game on a lawn" class="intro-img" widths={[640, 1100, 1600]} sizes="(max-width: 800px) 92vw, 62vw" />
      </section>

      <!-- Games: numbered, divided columns -->
      <section class="wrap" id="games">
        <div class="split-head">
          <h2>The first collection</h2>
          <p>Four classic games, given the giant treatment. Built from solid wood to last summer after summer.</p>
        </div>
        <ol class="games">
          {products.map((p, i) => (
            <li class="game">
              <h3><span class="num">{i + 1}</span>{p.name}</h3>
              <Image src={p.img} alt={p.name} widths={[320, 640]} sizes="(max-width: 800px) 92vw, 24vw" />
              <p>{p.blurb}</p>
              <p class="price">From {gbp(p.prices.S)}</p>
              <button type="button" class="pill pill-solid order-btn" aria-expanded="false" aria-controls={`order-${p.id}`}>Order <span aria-hidden="true">→</span></button>
              <form class="order" id={`order-${p.id}`} hidden data-product={p.id} data-name={p.name} data-prices={JSON.stringify(p.prices)}>
                <fieldset>
                  <legend>Choose a size</legend>
                  <div class="sizes">
                    {Object.entries(p.prices).map(([size, price], j) => (
                      <label>
                        <input type="radio" name="size" value={size} checked={j === 0} />
                        <span><strong>{size}</strong>{gbp(price)}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
                <button type="submit" class="pill pill-solid add-btn">Add to basket · <span data-line-price>{gbp(p.prices.S)}</span></button>
                <p class="added" role="status" aria-live="polite"></p>
              </form>
            </li>
          ))}
        </ol>
      </section>

      <!-- Video -->
      <section class="wrap" id="video">
        <div class="split-head">
          <h2>See it in action</h2>
          <p>From weddings to back-garden BBQs, GrandPlay turns any gathering into an event.</p>
        </div>
        <div class="video">
          <video controls playsinline preload="metadata" poster={`${base}video/poster.jpg`}>
            <source src={`${base}video/grandplay.mp4`} type="video/mp4" />
            Your browser can't play this video.
          </video>
        </div>
      </section>

      <!-- Why: numbered steps with rules -->
      <section class="wrap" id="why">
        <div class="split-head">
          <h2>Why GrandPlay</h2>
          <p>Made for the moments people come together.</p>
        </div>
        <ol class="steps">
          {benefits.map((b, i) => (
            <li><h3><span class="num">{i + 1}</span>{b.title}</h3><p>{b.text}</p></li>
          ))}
        </ol>
      </section>

      <!-- About HY-PRO -->
      <section class="wrap about">
        <Image src={gardenBowling} alt="A family playing giant bowling in their back garden during a BBQ" widths={[640, 1100, 1600]} sizes="(max-width: 800px) 92vw, 50vw" />
        <div>
          <p class="stat">30+</p>
          <h2>Years getting people active outdoors</h2>
          <p>GrandPlay comes from HY-PRO, which has spent over 30 years in the sports and outdoor industry. It's the right business to bring a new concept like this to life.</p>
        </div>
      </section>

      <!-- Join band -->
      <!-- Play for discounts -->
      <section class="wrap play-promo" id="play">
        <div class="split-head">
          <h2>Bowl a strike, win a discount</h2>
          <p>Try our garden skittles game. Two clicks: one for your aim, one for your power. Knock all nine pins down to reveal a discount code.</p>
        </div>
        <a class="pill pill-solid" href={`${base}play/`}>Play garden skittles <span aria-hidden="true">→</span></a>
        <p class="small play-note">Preview: codes shown in the game are demo codes and can't be used yet.</p>
      </section>

      <section class="band" id="contact">
        <Image src={moonTeam} alt="" class="band-bg" widths={[800, 1600]} sizes="100vw" />
        <div class="band-inner">
          <h2>Be first to play big</h2>
          <p>Pricing and availability coming soon. Register your interest and we'll be in touch.</p>
          <a class="pill pill-solid" href={`mailto:${contactEmail}`}>Register interest <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </main>

    <div class="drawer-backdrop" data-basket-close hidden></div>
    <aside class="drawer" id="basket" aria-label="Basket" aria-hidden="true" tabindex="-1">
      <div class="drawer-head">
        <h2>Your basket</h2>
        <button type="button" class="close" data-basket-close aria-label="Close basket">×</button>
      </div>
      <ul class="lines" data-basket-lines></ul>
      <p class="empty" data-basket-empty>Your basket is empty.</p>
      <div class="drawer-foot" data-basket-foot hidden>
        <p class="total"><span>Total</span><strong data-basket-total>£0</strong></p>
        <a class="pill pill-solid checkout" data-basket-checkout href="#">Send order enquiry <span aria-hidden="true">→</span></a>
        <p class="small">Online checkout is coming soon. For now this emails your order to our team and we'll confirm availability and delivery.</p>
      </div>
    </aside>

    <footer class="wrap footer">
      <p class="tagline">Think big. Play big.</p>
      <div class="footer-row">
        <img src={`${base}logo.png`} alt="GrandPlay" width="150" height="102" />
        <nav aria-label="Footer">
          <a href="#games">Games</a>
          <a href="#video">Video</a>
          <a href="#why">Why GrandPlay</a>
          <a href={`${base}play/`}>Play skittles</a>
          <a href="#contact">Contact</a>
        </nav>
      </div>
      <p class="small">© {new Date().getFullYear()} HY-PRO. GrandPlay is a HY-PRO brand. Created by The Moonwalkers.</p>
    </footer>

    <style is:global>
      :root {
        --cream: #fbf8ef;
        --cream-2: #f1ecdd;
        --ink: #2d2b29;
        --ink-soft: rgb(45 43 41 / .65);
        --green: #2e5e40;
        --green-dark: #1f4430;
        --wood: #9a5b2e;
        --rule: rgb(45 43 41 / .2);
        --gutter: clamp(16px, 3vw, 40px);
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      section[id] { scroll-margin-top: 80px; }
      body { margin: 0; background: var(--cream); color: var(--ink); font-family: 'Inter Tight', system-ui, -apple-system, sans-serif; font-size: 18px; line-height: 1.45; }
      img, video { max-width: 100%; display: block; }
      img { height: auto; }
      a { color: inherit; }
      h1, h2, h3 { font-weight: 500; letter-spacing: -0.035em; line-height: 1; margin: 0; }
      h2 { font-size: clamp(2.2rem, 5vw, 4rem); }
      h3 { font-size: clamp(1.5rem, 2.4vw, 2rem); }
      p { margin: 0; }

      .skip { position: absolute; left: -999px; top: 0; background: var(--ink); color: var(--cream); padding: 8px 16px; z-index: 100; }
      .skip:focus { left: 8px; top: 8px; }

      /* Nav sits over the hero */
      .nav { position: absolute; top: 0; left: 0; right: 0; z-index: 10; display: flex; justify-content: space-between; align-items: center; padding: 18px var(--gutter); }
      .brand img { height: 52px; width: auto; }
      .brand { display: flex; align-items: center; gap: 10px; color: var(--cream); text-decoration: none; font-weight: 600; font-size: 1.15rem; letter-spacing: -0.02em; }
      .nav nav { display: flex; gap: 8px; }

      .pill { display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; text-decoration: none; font-size: .9rem; font-weight: 500; padding: 8px 14px; transition: background .2s, transform .2s; }
      .pill-glass { color: var(--cream); background: rgb(45 43 41 / .15); border: 1px solid rgb(251 248 239 / .6); backdrop-filter: blur(8px); }
      .pill-glass:hover { background: rgb(45 43 41 / .35); }
      .pill-solid { background: var(--green); color: var(--cream); font-size: 1.05rem; padding: 12px 20px; }
      .pill-solid:hover { background: var(--green-dark); transform: translateY(-1px); }

      /* Hero */
      .hero { position: relative; height: 100svh; min-height: 520px; overflow: hidden; background: var(--green-dark); }
      .hero video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
      .hero-shade { position: absolute; inset: 0; background: linear-gradient(to top, rgb(0 0 0 / .5), transparent 45%), linear-gradient(to bottom, rgb(0 0 0 / .35), transparent 20%); }
      .hero h1 { position: absolute; left: var(--gutter); bottom: clamp(150px, 20vh, 200px); color: var(--cream); font-size: clamp(3rem, 9vw, 7.5rem); }

      .wrap { padding: clamp(64px, 9vw, 128px) var(--gutter) 0; max-width: 1600px; margin: 0 auto; }

      /* Intro */
      .intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr); gap: clamp(24px, 4vw, 64px); align-items: start; padding-top: clamp(24px, 3vw, 40px); }
      .intro-text { display: grid; gap: 28px; }
      .intro-text p { font-size: 1rem; max-width: 34ch; }
      .intro-img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
      .arrow-link { color: var(--green); text-decoration: none; font-size: 1rem; font-weight: 500; }
      .arrow-link:hover { text-decoration: underline; }

      /* Section heads: title left, note right of a vertical rule */
      .split-head { display: grid; grid-template-columns: 2fr 1fr; gap: 24px; align-items: start; margin-bottom: clamp(32px, 5vw, 72px); }
      .split-head p { font-size: .95rem; border-left: 1px solid var(--rule); padding: 4px 0 64px 16px; max-width: 34ch; }

      .num { display: inline-grid; place-items: center; width: 1.1em; height: 1.1em; border-radius: 50%; background: var(--ink); color: var(--cream); font-size: .5em; letter-spacing: 0; margin-right: .3em; vertical-align: .35em; }

      /* Games */
      .games { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); }
      .game { border-left: 1px solid var(--rule); padding: 0 clamp(12px, 1.5vw, 24px) 8px; display: grid; gap: 16px; align-content: start; }
      .game:last-child { border-right: 1px solid var(--rule); }
      .game img { width: 100%; aspect-ratio: 1; object-fit: cover; }
      .game p { font-size: .95rem; color: var(--ink-soft); }
      .price { font-size: .85rem; font-weight: 600; color: var(--wood); }

      /* Video */
      .video { aspect-ratio: 16 / 9; background: var(--ink); }
      .video video { width: 100%; height: 100%; object-fit: cover; }

      /* Why */
      .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); }
      .steps li { border-left: 1px solid var(--rule); padding: 0 clamp(12px, 1.5vw, 24px) 48px; display: grid; gap: 14px; }
      .steps p { font-size: .95rem; color: var(--ink-soft); }
      .occasions { list-style: none; padding: 0; margin: 40px 0 0; display: flex; flex-wrap: wrap; gap: 6px 0; font-size: 1.05rem; }
      .occasions li:not(:last-child)::after { content: '·'; margin: 0 12px; color: var(--ink-soft); }

      /* About */
      .about { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 4vw, 64px); align-items: center; }
      .about img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
      .about > div { display: grid; gap: 20px; }
      .about p:not(.stat) { font-size: 1rem; max-width: 46ch; }
      .stat { font-size: clamp(4rem, 10vw, 8rem); font-weight: 500; letter-spacing: -0.05em; line-height: .9; color: var(--green); }

      /* Join band */
      .band { position: relative; margin-top: clamp(64px, 9vw, 128px); min-height: 70vh; display: grid; align-items: end; overflow: hidden; background: var(--ink); }
      .band-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .75; }
      .band::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to right, rgb(0 0 0 / .55), transparent 65%); }
      .band-inner { position: relative; z-index: 1; padding: clamp(32px, 5vw, 64px) var(--gutter); color: var(--cream); display: grid; gap: 20px; justify-items: start; max-width: 720px; }
      .band-inner p { font-size: 1rem; }

      /* Footer */
      .footer { padding-bottom: 40px; }
      .tagline { font-size: clamp(2.6rem, 8vw, 6.5rem); font-weight: 500; letter-spacing: -0.045em; line-height: 1; color: var(--wood); }
      .footer-row { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin: 48px 0 32px; padding-top: 24px; border-top: 1px solid var(--rule); flex-wrap: wrap; }
      .footer-row nav { display: flex; gap: 24px; flex-wrap: wrap; font-size: .95rem; }
      .footer-row nav a { text-decoration: none; }
      .footer-row nav a:hover { color: var(--green); }
      .small { font-size: .8rem; color: var(--ink-soft); }

      /* Scroll cue */
      .scroll-cue { position: absolute; left: 50%; bottom: clamp(20px, 4vh, 40px); transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 10px; color: var(--cream); text-decoration: none; font-size: clamp(1.3rem, 2.6vw, 1.8rem); font-weight: 600; letter-spacing: .02em; text-shadow: 0 1px 8px rgb(0 0 0 / .4); }
      .scroll-cue svg { filter: drop-shadow(0 1px 6px rgb(0 0 0 / .35)); }
      .scroll-cue .chev { animation: chev 1.6s ease-in-out infinite; }
      @keyframes chev { 0%, 100% { transform: translateY(0); opacity: .6; } 50% { transform: translateY(6px); opacity: 1; } }
      .play-promo { display: grid; gap: 16px; justify-items: start; }
      .play-promo .split-head { margin-bottom: 8px; width: 100%; }
      .scroll-dot { animation: scroll-dot 1.6s ease-in-out infinite; }
      @keyframes scroll-dot { 0% { transform: translateY(0); opacity: 1; } 70% { transform: translateY(10px); opacity: 0; } 100% { transform: translateY(0); opacity: 0; } }

      /* Ordering */
      .price { font-size: 1rem; font-weight: 600; color: var(--wood); }
      .game p.price { color: var(--wood); }
      .order-btn { justify-self: start; border: 0; cursor: pointer; font-family: inherit; }
      .order[hidden] { display: none; }
      .order { display: grid; gap: 12px; padding-top: 4px; }
      .order fieldset { border: 0; padding: 0; margin: 0; }
      .order legend { font-size: .85rem; color: var(--ink-soft); margin-bottom: 8px; }
      .sizes { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
      .sizes label { cursor: pointer; }
      .sizes input { position: absolute; opacity: 0; pointer-events: none; }
      .sizes span { display: grid; gap: 2px; text-align: center; border: 1px solid var(--rule); border-radius: 10px; padding: 8px 4px; font-size: .8rem; color: var(--ink-soft); transition: border-color .15s, background .15s; }
      .sizes strong { font-size: 1rem; color: var(--ink); font-weight: 600; }
      .sizes input:checked + span { border-color: var(--green); background: rgb(46 94 64 / .08); color: var(--green); }
      .sizes input:focus-visible + span { outline: 2px solid var(--green); outline-offset: 2px; }
      .add-btn { border: 0; cursor: pointer; font-family: inherit; font-size: .95rem; justify-content: center; }
      .added { font-size: .85rem; color: var(--green); min-height: 1.2em; }

      /* Basket button + drawer */
      .basket-btn { cursor: pointer; font-family: inherit; }
      .basket-count { display: inline-grid; place-items: center; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 999px; background: var(--cream); color: var(--green-dark); font-size: .75rem; font-weight: 600; }
      .nav.solid { position: fixed; background: var(--cream); box-shadow: 0 1px 0 var(--rule); }
      .nav.solid .brand { color: var(--green); }
      .logo-dark, .nav.solid .logo-light { display: none; }
      .nav.solid .logo-dark { display: block; }
      .nav.solid .pill-glass { color: var(--ink); border-color: var(--rule); background: transparent; }
      .nav.solid .basket-count { background: var(--green); color: var(--cream); }
      .drawer-backdrop { position: fixed; inset: 0; background: rgb(0 0 0 / .35); z-index: 40; }
      .drawer { position: fixed; top: 0; right: 0; bottom: 0; width: min(420px, 100vw); background: var(--cream); z-index: 50; transform: translateX(100%); transition: transform .25s ease; display: flex; flex-direction: column; padding: 20px var(--gutter); overflow-y: auto; }
      .drawer.open { transform: none; box-shadow: -8px 0 32px rgb(0 0 0 / .15); }
      .drawer-head { display: flex; justify-content: space-between; align-items: center; padding-bottom: 16px; border-bottom: 1px solid var(--rule); }
      .drawer-head h2 { font-size: 2rem; }
      .close { background: none; border: 0; font-size: 2rem; line-height: 1; cursor: pointer; color: var(--ink); padding: 4px 8px; }
      .lines { list-style: none; padding: 0; margin: 0; }
      .lines li { display: grid; grid-template-columns: 1fr auto; gap: 8px; padding: 16px 0; border-bottom: 1px solid var(--rule); }
      .lines .meta { font-size: .85rem; color: var(--ink-soft); }
      .qty { display: flex; align-items: center; gap: 8px; margin-top: 8px; }
      .qty button { width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--rule); background: none; cursor: pointer; font-size: 1rem; color: var(--ink); }
      .qty .remove { width: auto; height: auto; border-radius: 0; background: none; border: 0; color: var(--ink-soft); text-decoration: underline; cursor: pointer; font-size: .8rem; margin-left: 8px; font-family: inherit; }
      .line-total { font-weight: 600; }
      .empty { padding: 24px 0; color: var(--ink-soft); }
      .drawer-foot { margin-top: auto; padding-top: 20px; display: grid; gap: 14px; }
      .drawer-foot[hidden] { display: none; }
      .total { display: flex; justify-content: space-between; font-size: 1.2rem; }
      .checkout { justify-content: center; }

      @media (max-width: 900px) {
        .games { grid-template-columns: repeat(2, 1fr); row-gap: 40px; }
        .game:nth-child(2) { border-right: 1px solid var(--rule); }
      }
      @media (max-width: 700px) {
        .intro, .about, .split-head { grid-template-columns: 1fr; }
        .split-head p { padding-bottom: 8px; }
        .games, .steps { grid-template-columns: 1fr; }
        .game, .game:nth-child(2), .game:last-child { border-right: 0; }
        .steps li { padding-bottom: 32px; }
        .game img { max-width: 280px; }
        .brand span { display: none; }

      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .pill, .drawer { transition: none; }
        .scroll-dot, .scroll-cue .chev { animation: none; }
      }
    </style>
    <script is:inline>
      // ---- Client-side basket (no backend; saved in this browser only) ----
      (() => {
        const KEY = 'grandplay-basket';
        const ORDER_EMAIL = 'rania@hy-pro.co.uk'; // TODO: real orders email
        const gbp = (n) => '£' + n.toLocaleString('en-GB');
        let basket = [];
        try { basket = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { basket = []; }
        const save = () => { try { localStorage.setItem(KEY, JSON.stringify(basket)); } catch {} };

        const $ = (s) => document.querySelector(s);
        const drawer = $('#basket'), backdrop = $('.drawer-backdrop');
        const linesEl = $('[data-basket-lines]'), emptyEl = $('[data-basket-empty]'), footEl = $('[data-basket-foot]');
        const totalEl = $('[data-basket-total]'), countEl = $('[data-basket-count]'), checkoutEl = $('[data-basket-checkout]');

        function render() {
          const count = basket.reduce((n, l) => n + l.qty, 0);
          const total = basket.reduce((n, l) => n + l.qty * l.price, 0);
          countEl.textContent = count;
          linesEl.innerHTML = '';
          basket.forEach((l, i) => {
            const li = document.createElement('li');
            li.innerHTML = `<div><div>${l.name}</div><div class="meta">Size ${l.size} · ${gbp(l.price)} each</div>
              <div class="qty"><button type="button" data-dec="${i}" aria-label="Decrease quantity">−</button><span>${l.qty}</span>
              <button type="button" data-inc="${i}" aria-label="Increase quantity">+</button><button type="button" class="remove" data-rm="${i}">Remove</button></div></div>
              <div class="line-total">${gbp(l.qty * l.price)}</div>`;
            linesEl.appendChild(li);
          });
          emptyEl.hidden = basket.length > 0;
          footEl.hidden = basket.length === 0;
          totalEl.textContent = gbp(total);
          const body = basket.map((l) => `${l.qty} x ${l.name} (${l.size}) @ ${gbp(l.price)} = ${gbp(l.qty * l.price)}`).join('\n') + `\n\nTotal: ${gbp(total)}\n\nName:\nDelivery postcode:\nPhone:`;
          checkoutEl.href = `mailto:${ORDER_EMAIL}?subject=${encodeURIComponent('GrandPlay order enquiry')}&body=${encodeURIComponent(body)}`;
        }

        function open() { drawer.classList.add('open'); drawer.setAttribute('aria-hidden', 'false'); backdrop.hidden = false; drawer.focus(); }
        function close() { drawer.classList.remove('open'); drawer.setAttribute('aria-hidden', 'true'); backdrop.hidden = true; }
        document.querySelectorAll('[data-basket-open]').forEach((b) => b.addEventListener('click', open));
        document.querySelectorAll('[data-basket-close]').forEach((b) => b.addEventListener('click', close));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

        linesEl.addEventListener('click', (e) => {
          const t = e.target.closest('button'); if (!t) return;
          const i = +(t.dataset.inc ?? t.dataset.dec ?? t.dataset.rm);
          if (t.dataset.inc !== undefined) basket[i].qty++;
          else if (t.dataset.dec !== undefined) { basket[i].qty--; if (basket[i].qty < 1) basket.splice(i, 1); }
          else if (t.dataset.rm !== undefined) basket.splice(i, 1);
          save(); render();
        });

        // Order buttons reveal the size picker
        document.querySelectorAll('.order-btn').forEach((btn) => btn.addEventListener('click', () => {
          const form = document.getElementById(btn.getAttribute('aria-controls'));
          const show = form.hidden; form.hidden = !show; btn.setAttribute('aria-expanded', String(show));
        }));

        document.querySelectorAll('form.order').forEach((form) => {
          const prices = JSON.parse(form.dataset.prices);
          const priceEl = form.querySelector('[data-line-price]'), status = form.querySelector('.added');
          form.addEventListener('change', () => { priceEl.textContent = gbp(prices[form.size.value]); status.textContent = ''; });
          form.addEventListener('submit', (e) => {
            e.preventDefault();
            const size = form.size.value, id = form.dataset.product;
            const line = basket.find((l) => l.id === id && l.size === size);
            if (line) line.qty++; else basket.push({ id, name: form.dataset.name, size, price: prices[size], qty: 1 });
            save(); render();
            status.innerHTML = `Added size ${size}. <a href="#basket" data-basket-open>View basket</a>`;
            status.querySelector('a').addEventListener('click', (ev) => { ev.preventDefault(); open(); });
          });
        });

        // Solid nav once past the hero, so the basket stays reachable
        const nav = $('.nav'), hero = $('.hero');
        new IntersectionObserver(([en]) => nav.classList.toggle('solid', !en.isIntersecting), { rootMargin: '-80px 0px 0px 0px' }).observe(hero);

        render();
      })();

      // Respect reduced-motion: pause the background hero video.
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const v = document.querySelector('.hero video'); if (v) { v.removeAttribute('autoplay'); v.pause(); }
      }
    </script>
  </body>
</html>
